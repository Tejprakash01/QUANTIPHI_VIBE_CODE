# ==========================================
# Backend Environment Configuration
# ==========================================

# Port (assigned automatically by Render or default 8000 locally)
PORT=8000

# Environment mode ('development' or 'production')
APP_ENV=production

# Optional: GitHub Personal Access Token (PAT)
# Increases rate limit from 60 to 5,000 requests/hr for server-side queries.
# Keep this value secret and do NOT commit your actual token into git!
GITHUB_TOKEN=
